[Unit]
Description=OSNT ADS-B plugin
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/osnt-adsb
Environment=OSNT_ADSB_BIND=127.0.0.1:8101
Environment=OSNT_ADSB_DB=/var/lib/osnt-adsb/adsb.redb
Restart=on-failure
RestartSec=3
DynamicUser=yes
StateDirectory=osnt-adsb
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
