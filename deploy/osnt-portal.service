[Unit]
Description=OSNT portal
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/osnt-portal
Environment=OSNT_BIND=127.0.0.1:8080
Environment=OSNT_STATE_DIR=/var/lib/osnt
StateDirectory=osnt
UMask=0077
Environment=OSNT_TLS_BIND=0.0.0.0:443
Environment=OSNT_HTTP_BIND=0.0.0.0:80
Environment=OSNT_PUBLIC_HOST=osnt-pi.local
LoadCredential=tls.crt:/etc/osnt/tls/tls.crt
LoadCredential=tls.key:/etc/osnt/tls/tls.key
LoadCredential=gateway.key:/etc/osnt/gateway.key
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=2
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
