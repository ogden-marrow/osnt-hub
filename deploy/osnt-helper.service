[Unit]
Description=OSNT package installer (runs when the Packages page queues a request)

[Service]
Type=oneshot
ExecStart=/usr/local/bin/osnt-helper
TimeoutStartSec=600
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/etc/osnt /etc/systemd/system /usr/local/bin /var/lib
