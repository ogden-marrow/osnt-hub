[Unit]
Description=OSNT package installer (runs when the Packages page queues a request)

[Service]
Type=oneshot
ExecStart=/usr/local/bin/osnt-helper
TimeoutStartSec=1800
# Installing system packages (apt) writes all over the filesystem, so this service cannot use ProtectSystem=strict.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
