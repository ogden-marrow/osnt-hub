[Unit]
Description=OSNT imagery plugin
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/osnt-imagery
Environment=OSNT_IMAGERY_BIND=127.0.0.1:8102
Restart=on-failure
RestartSec=3
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
